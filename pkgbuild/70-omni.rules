# Lets the logged-in user configure these keyboards without root.
# SteelSeries Apex Pro TKL Gen 3 (wired)
KERNEL=="hidraw*", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1642", TAG+="uaccess"
# Wooting 60HE v2 in its three gamepad modes; never the bootloader (134f).
KERNEL=="hidraw*", ATTRS{idVendor}=="31e3", ATTRS{idProduct}=="1340|1341|1342", TAG+="uaccess"
